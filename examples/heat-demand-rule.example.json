{
 "name": "Heat demand (Honeywell T6)",
 "actions": [
  {
   "if": {
    "lessThan": {
     "left": {
      "device": {
       "devices": [
        "<kitchen-floor-heating-device-id>"
       ],
       "component": "main",
       "capability": "temperatureMeasurement",
       "attribute": "temperature",
       "trigger": "Always"
      }
     },
     "right": {
      "device": {
       "devices": [
        "<kitchen-floor-heating-device-id>"
       ],
       "component": "main",
       "capability": "thermostatHeatingSetpoint",
       "attribute": "heatingSetpoint",
       "trigger": "Always"
      }
     }
    },
    "then": [
     {
      "command": {
       "devices": [
        "<honeywell-t6-device-id>"
       ],
       "commands": [
        {
         "component": "main",
         "capability": "silvervalley08660.heatDemand",
         "command": "setRoom",
         "arguments": [
          {
           "string": "Kitchen"
          },
          {
           "string": "on"
          }
         ]
        }
       ]
      }
     }
    ],
